{
  "name": "kostl-next",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --parallel --filter @kostl/api --filter @kostl/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "typecheck": "pnpm -r typecheck",
    "deploy": "pnpm deploy:api && pnpm deploy:web",
    "deploy:dry-run": "pnpm deploy:api:dry-run && pnpm deploy:web:dry-run",
    "deploy:api": "pnpm --filter @kostl/api run deploy",
    "deploy:api:dry-run": "pnpm --filter @kostl/api run deploy:dry-run",
    "deploy:web": "pnpm --filter @kostl/web run deploy",
    "deploy:web:dry-run": "pnpm --filter @kostl/web run deploy:dry-run"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^3.2.0",
    "prettier": "^2.5.1",
    "typescript": "~5.9.3"
  }
}
