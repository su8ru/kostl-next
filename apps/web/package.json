{
  "name": "@kostl/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 8000",
    "build": "next build",
    "start": "next start",
    "generate": "pathpida --enableStatic",
    "pregenerate": "pnpm --filter @kostl/shared build && pnpm --filter @kostl/api build",
    "prebuild": "pnpm generate",
    "pretypecheck": "pnpm generate",
    "lint": "eslint --max-warnings 0 --ext .ts,.js,.tsx src next.config.js && prettier --config ../../.prettierrc.js --ignore-path ../../.prettierignore --plugin ../../node_modules/@trivago/prettier-plugin-sort-imports/lib/src/index.js --check \"src/**/*.{ts,tsx,js}\" \"next.config.js\"",
    "lint:fix": "eslint --ext .ts,.js,.tsx src next.config.js --fix && prettier --config ../../.prettierrc.js --ignore-path ../../.prettierignore --plugin ../../node_modules/@trivago/prettier-plugin-sort-imports/lib/src/index.js --write \"src/**/*.{ts,tsx,js}\" \"next.config.js\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chakra-ui/icon": "^1.2.1",
    "@chakra-ui/react": "^1.8.6",
    "@chakra-ui/styled-system": "^1.19.0",
    "@chakra-ui/theme-tools": "^1.3.6",
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "@kostl/api": "workspace:*",
    "@kostl/shared": "workspace:*",
    "csstype": "^3.2.3",
    "dayjs": "^1.11.0",
    "framer-motion": "^6",
    "hono": "^4.0.0",
    "jotai": "^1.7.2",
    "memory-cache": "^0.2.0",
    "next": "^12.0.10",
    "next-pwa": "^5.5.4",
    "pathpida": "^0.18.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-icons": "^4.3.1",
    "react-spring-bottom-sheet": "^3.4.1",
    "swr": "^1.2.1"
  },
  "devDependencies": {
    "@types/gtag.js": "^0.0.10",
    "@types/memory-cache": "^0.2.6",
    "@types/node": "^17.0.15",
    "@types/react": "^17.0.39",
    "@typescript-eslint/eslint-plugin": "^5.10.2",
    "@typescript-eslint/parser": "^5.10.2",
    "eslint": "^7.24.0",
    "eslint-config-next": "^12.1.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-react": "^7.28.0",
    "notios": "^0.4.0",
    "sass": "^1.49.9",
    "typescript": "~5.9.3"
  }
}
