{
  "name": "@kostl/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 8000",
    "build": "next build",
    "build:worker": "pnpm build && pnpm export",
    "export": "next export",
    "start": "next start",
    "deploy": "pnpm build:worker && wrangler deploy",
    "deploy:dry-run": "pnpm build:worker && wrangler deploy --dry-run",
    "generate": "pathpida --enableStatic",
    "pregenerate": "pnpm --filter @kostl/shared build && pnpm --filter @kostl/api build",
    "prebuild": "pnpm generate",
    "pretypecheck": "pnpm generate",
    "lint": "eslint --max-warnings 0 --ext .ts,.js,.tsx src next.config.js && prettier --config ../../.prettierrc.js --ignore-path ../../.prettierignore --plugin ../../node_modules/@trivago/prettier-plugin-sort-imports/lib/src/index.js --check \"src/**/*.{ts,tsx,js}\" \"next.config.js\"",
    "lint:fix": "eslint --ext .ts,.js,.tsx src next.config.js --fix && prettier --config ../../.prettierrc.js --ignore-path ../../.prettierignore --plugin ../../node_modules/@trivago/prettier-plugin-sort-imports/lib/src/index.js --write \"src/**/*.{ts,tsx,js}\" \"next.config.js\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chakra-ui/icon": "^2.0.5",
    "@chakra-ui/react": "^2.10.10",
    "@chakra-ui/styled-system": "^2.12.5",
    "@chakra-ui/theme-tools": "^2.2.10",
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "@kostl/api": "workspace:*",
    "@kostl/shared": "workspace:*",
    "csstype": "^3.2.3",
    "dayjs": "^1.11.21",
    "framer-motion": "^6",
    "hono": "^4.12.27",
    "jotai": "^1.13.1",
    "memory-cache": "^0.2.0",
    "next": "^12.3.7",
    "next-pwa": "^5.6.0",
    "pathpida": "^0.26.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^4.12.0",
    "react-spring-bottom-sheet": "^3.4.1",
    "swr": "^1.3.0"
  },
  "devDependencies": {
    "@types/gtag.js": "^0.0.20",
    "@types/memory-cache": "^0.2.6",
    "@types/node": "^24.13.2",
    "@types/react": "^18.3.31",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^7.32.0",
    "eslint-config-next": "^12.3.7",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-react": "^7.37.5",
    "notios": "^0.5.3",
    "sass": "^1.101.0",
    "typescript": "~5.9.3",
    "wrangler": "^4.107.0"
  }
}
