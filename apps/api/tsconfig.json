{
  "compilerOptions": {
    "baseUrl": ".",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["esnext"],
    "module": "esnext",
    "moduleResolution": "node",
    "paths": {
      "@kostl/shared/*": ["../../packages/shared/src/*"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src/**/*.ts"]
}
